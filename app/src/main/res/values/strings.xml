    <string name="settings_token_unreachable">Cannot reach the server to check the token</string>
    <string name="signin_totp_background_note">Heads up: with two-factor authentication the app cannot sign in again by itself, so saving links in the background will stop working after a while. Add an API token in Settings to avoid that.</string>
